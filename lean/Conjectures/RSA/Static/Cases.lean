import Conjectures.RSA.Basic

/-! `Sstar` is the only maximal independent set of the tree with at most 6 vertices: a case
analysis generated by a script; every leaf finds two adjacent vertices in `S`, an undominated
vertex, or 7 vertices in `S`. -/

namespace RSA

open Finset

/-! #### Static side: `Sstar` is the only maximal independent set with at most 6 vertices. -/

lemma undom1 (S : Finset (Fin 15)) (hD : ∀ v, v ∉ S → ∃ w ∈ S, tree.Adj v w) (v a : Fin 15)
    (hnb : ∀ w, tree.Adj v w → w = a) (hv : v ∉ S) (ha : a ∉ S) : False := by
  obtain ⟨w, hw, hadj⟩ := hD v hv
  obtain rfl := hnb w hadj
  exact ha hw

lemma undom2 (S : Finset (Fin 15)) (hD : ∀ v, v ∉ S → ∃ w ∈ S, tree.Adj v w) (v a b : Fin 15)
    (hnb : ∀ w, tree.Adj v w → w = a ∨ w = b) (hv : v ∉ S) (ha : a ∉ S) (hb : b ∉ S) : False := by
  obtain ⟨w, hw, hadj⟩ := hD v hv
  rcases hnb w hadj with rfl | rfl
  · exact ha hw
  · exact hb hw

lemma undom3 (S : Finset (Fin 15)) (hD : ∀ v, v ∉ S → ∃ w ∈ S, tree.Adj v w) (v a b c : Fin 15)
    (hnb : ∀ w, tree.Adj v w → w = a ∨ w = b ∨ w = c) (hv : v ∉ S) (ha : a ∉ S) (hb : b ∉ S)
    (hc : c ∉ S) : False := by
  obtain ⟨w, hw, hadj⟩ := hD v hv
  rcases hnb w hadj with rfl | rfl | rfl
  · exact ha hw
  · exact hb hw
  · exact hc hw

lemma card7 (S : Finset (Fin 15)) (hcard : S.card ≤ 6) (l : List (Fin 15))
    (hl : l.Nodup ∧ l.length = 7) (h : ∀ x ∈ l, x ∈ S) : False := by
  have : l.toFinset ⊆ S := fun x hx => h x (List.mem_toFinset.1 hx)
  have := card_le_card this
  rw [List.toFinset_card_of_nodup hl.1, hl.2] at this
  omega

lemma pin (S : Finset (Fin 15)) (h0 : (0 : Fin 15) ∈ S) (h1 : (1 : Fin 15) ∉ S) (h2 : (2 : Fin 15) ∉ S) (h3 : (3 : Fin 15) ∉ S) (h4 : (4 : Fin 15) ∉ S) (h5 : (5 : Fin 15) ∉ S) (h6 : (6 : Fin 15) ∈ S) (h7 : (7 : Fin 15) ∈ S) (h8 : (8 : Fin 15) ∈ S) (h9 : (9 : Fin 15) ∉ S) (h10 : (10 : Fin 15) ∉ S) (h11 : (11 : Fin 15) ∉ S) (h12 : (12 : Fin 15) ∉ S) (h13 : (13 : Fin 15) ∈ S) (h14 : (14 : Fin 15) ∈ S) : S = Sstar := by
  ext x
  fin_cases x <;> simp_all [Sstar]

/-- The neighbours of each vertex. -/
theorem nb0 : ∀ w : Fin 15, tree.Adj 0 w → w = 1 ∨ w = 2 ∨ w = 3 := by decide +kernel

theorem nb1 : ∀ w : Fin 15, tree.Adj 1 w → w = 0 ∨ w = 4 := by decide +kernel

theorem nb2 : ∀ w : Fin 15, tree.Adj 2 w → w = 0 ∨ w = 5 := by decide +kernel

theorem nb3 : ∀ w : Fin 15, tree.Adj 3 w → w = 0 ∨ w = 6 := by decide +kernel

theorem nb4 : ∀ w : Fin 15, tree.Adj 4 w → w = 1 ∨ w = 7 := by decide +kernel

theorem nb5 : ∀ w : Fin 15, tree.Adj 5 w → w = 2 ∨ w = 8 := by decide +kernel

theorem nb6 : ∀ w : Fin 15, tree.Adj 6 w → w = 3 := by decide +kernel

theorem nb7 : ∀ w : Fin 15, tree.Adj 7 w → w = 4 ∨ w = 9 ∨ w = 10 := by decide +kernel

theorem nb8 : ∀ w : Fin 15, tree.Adj 8 w → w = 5 ∨ w = 11 ∨ w = 12 := by decide +kernel

theorem nb9 : ∀ w : Fin 15, tree.Adj 9 w → w = 7 ∨ w = 13 := by decide +kernel

theorem nb10 : ∀ w : Fin 15, tree.Adj 10 w → w = 7 := by decide +kernel

theorem nb11 : ∀ w : Fin 15, tree.Adj 11 w → w = 8 ∨ w = 14 := by decide +kernel

theorem nb12 : ∀ w : Fin 15, tree.Adj 12 w → w = 8 := by decide +kernel

theorem nb13 : ∀ w : Fin 15, tree.Adj 13 w → w = 9 := by decide +kernel

theorem nb14 : ∀ w : Fin 15, tree.Adj 14 w → w = 11 := by decide +kernel

