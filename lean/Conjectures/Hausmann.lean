import Mathlib.Combinatorics.SimpleGraph.Clique
import Mathlib.Combinatorics.SimpleGraph.Connectivity.Connected
import Mathlib.Data.Set.Card

/-!
# Question 5.4 of Hausmann, arXiv:2611.05178, has answer "no"

W. Hausmann, *Weighted Max Cut in Subcubic Graphs*, arXiv:2611.05178, Question 5.4:

> Does every subcubic graph G of odd girth exactly five admit a partition V(G) = L ∪ R such that
> L is independent and every component of G[R] has order at most three?

We state the question for every finite simple graph (`Question54`) and prove `¬ Question54`,
using the Wagner graph `V₈` (the 8-cycle plus its four long diagonals) as the counterexample.

The case analysis over independent sets `L` of `V₈` was generated by a short script: each leaf
either finds two adjacent vertices in `L`, or exhibits a path on 4 vertices outside `L`.
-/

namespace Hausmann

open SimpleGraph

/-- `G` has odd girth exactly `k`: some odd cycle has length `k`, and every odd cycle has
length at least `k`. -/
def HasOddGirth {V : Type*} (G : SimpleGraph V) (k : ℕ) : Prop :=
  (∃ (u : V) (p : G.Walk u u), p.IsCycle ∧ Odd p.length ∧ p.length = k) ∧
    ∀ (u : V) (p : G.Walk u u), p.IsCycle → Odd p.length → k ≤ p.length

/-- Hausmann's Question 5.4, asked for every finite simple graph: if `G` is subcubic (every
degree is at most 3) and has odd girth exactly 5, then there is an independent set `L` such that
every connected component of `G[V ∖ L]` has at most 3 vertices. -/
def Question54 : Prop :=
  ∀ (V : Type) [Fintype V] [DecidableEq V] (G : SimpleGraph V) [DecidableRel G.Adj],
    (∀ v, G.degree v ≤ 3) → HasOddGirth G 5 →
      ∃ L : Set V, G.IsIndepSet L ∧
        ∀ c : (G.induce Lᶜ).ConnectedComponent, c.supp.ncard ≤ 3

/-- The Wagner graph `V₈`: vertices `0, …, 7`, `i ~ j` iff `j - i ≡ ±1` or `4 (mod 8)`. -/
def wagner : SimpleGraph (Fin 8) where
  Adj i j := (j.val + 8 - i.val) % 8 = 1 ∨ (j.val + 8 - i.val) % 8 = 4 ∨
    (j.val + 8 - i.val) % 8 = 7
  symm := ⟨by decide⟩
  loopless := ⟨by decide⟩

instance : DecidableRel wagner.Adj := fun i j => by unfold wagner; infer_instance

theorem wagner_degree (v : Fin 8) : wagner.degree v = 3 := by
  revert v; decide

theorem wagner_triangleFree (a b c : Fin 8) (h1 : wagner.Adj a b) (h2 : wagner.Adj b c)
    (h3 : wagner.Adj c a) : False := by
  revert a b c; decide

/-- A closed walk of length 3 is a triangle, and `V₈` has none. -/
theorem wagner_no_closed_walk_three {u : Fin 8} (p : wagner.Walk u u) (h : p.length = 3) :
    False := by
  cases p with
  | nil => simp at h
  | cons h1 p =>
    cases p with
    | nil => simp at h
    | cons h2 p =>
      cases p with
      | nil => simp at h
      | cons h3 p =>
        cases p with
        | nil => exact wagner_triangleFree _ _ _ h1 h2 h3
        | cons h4 p => simp [Walk.length_cons] at h

/-- The 5-cycle `0 1 2 3 7 0`. -/
def fiveCycle : wagner.Walk 0 0 :=
  .cons (by decide : wagner.Adj 0 1) <| .cons (by decide : wagner.Adj 1 2) <|
    .cons (by decide : wagner.Adj 2 3) <| .cons (by decide : wagner.Adj 3 7) <|
      .cons (by decide : wagner.Adj 7 0) .nil

theorem wagner_oddGirth : HasOddGirth wagner 5 := by
  refine ⟨⟨0, fiveCycle, ?_, by decide, rfl⟩, fun u p hp hodd => ?_⟩
  · rw [fiveCycle, Walk.cons_isCycle_iff, Walk.isPath_def]
    exact ⟨by decide, by decide⟩
  · have h3 := hp.three_le_length
    by_contra hlt
    have : p.length = 3 := by
      obtain ⟨k, hk⟩ := hodd
      omega
    exact wagner_no_closed_walk_three p this

/-- Four distinct vertices outside `L` forming a path `a - b - c - d` lie in one component of
`V₈[Lᶜ]`, which then has more than 3 vertices. -/
theorem four (L : Set (Fin 8))
    (hc : ∀ c : (wagner.induce Lᶜ).ConnectedComponent, c.supp.ncard ≤ 3)
    (a b c d : Fin 8) (ha : a ∉ L) (hb : b ∉ L) (hc' : c ∉ L) (hd : d ∉ L)
    (hadj : wagner.Adj a b ∧ wagner.Adj b c ∧ wagner.Adj c d)
    (hdist : a ≠ b ∧ a ≠ c ∧ a ≠ d ∧ b ≠ c ∧ b ≠ d ∧ c ≠ d) : False := by
  obtain ⟨hab, hbc, hcd⟩ := hadj
  obtain ⟨d1, d2, d3, d4, d5, d6⟩ := hdist
  let xa : ↥(Lᶜ) := ⟨a, ha⟩
  let xb : ↥(Lᶜ) := ⟨b, hb⟩
  let xc : ↥(Lᶜ) := ⟨c, hc'⟩
  let xd : ↥(Lᶜ) := ⟨d, hd⟩
  have rab : (wagner.induce Lᶜ).Reachable xa xb := Adj.reachable hab
  have rbc : (wagner.induce Lᶜ).Reachable xb xc := Adj.reachable hbc
  have rcd : (wagner.induce Lᶜ).Reachable xc xd := Adj.reachable hcd
  set C := (wagner.induce Lᶜ).connectedComponentMk xa
  have hsub : ({xa, xb, xc, xd} : Set ↥(Lᶜ)) ⊆ C.supp := by
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rw [ConnectedComponent.mem_supp_iff]
    rcases hx with rfl | rfl | rfl | rfl
    · rfl
    · exact (ConnectedComponent.eq.2 rab).symm
    · exact (ConnectedComponent.eq.2 (rab.trans rbc)).symm
    · exact (ConnectedComponent.eq.2 ((rab.trans rbc).trans rcd)).symm
  have hcard : ({xa, xb, xc, xd} : Set ↥(Lᶜ)).ncard = 4 := by
    have e1 : xa ≠ xb := fun h => d1 (congrArg Subtype.val h)
    have e2 : xa ≠ xc := fun h => d2 (congrArg Subtype.val h)
    have e3 : xa ≠ xd := fun h => d3 (congrArg Subtype.val h)
    have e4 : xb ≠ xc := fun h => d4 (congrArg Subtype.val h)
    have e5 : xb ≠ xd := fun h => d5 (congrArg Subtype.val h)
    have e6 : xc ≠ xd := fun h => d6 (congrArg Subtype.val h)
    rw [Set.ncard_insert_of_notMem (by simp [e1, e2, e3]),
      Set.ncard_insert_of_notMem (by simp [e4, e5]), Set.ncard_pair e6]
  have := Set.ncard_le_ncard hsub (Set.toFinite _)
  have := hc C
  omega

theorem wagner_no_partition (L : Set (Fin 8)) (hL : wagner.IsIndepSet L)
    (hc : ∀ c : (wagner.induce Lᶜ).ConnectedComponent, c.supp.ncard ≤ 3) : False := by
  by_cases h0 : (0 : Fin 8) ∈ L
  · by_cases h1 : (1 : Fin 8) ∈ L
    · exact hL h0 h1 (by decide) (by decide)
    · by_cases h4 : (4 : Fin 8) ∈ L
      · exact hL h0 h4 (by decide) (by decide)
      · by_cases h6 : (6 : Fin 8) ∈ L
        · by_cases h2 : (2 : Fin 8) ∈ L
          · exact hL h2 h6 (by decide) (by decide)
          · by_cases h5 : (5 : Fin 8) ∈ L
            · exact hL h5 h6 (by decide) (by decide)
            · exact four L hc 2 1 5 4 h2 h1 h5 h4 (by decide) (by decide)
        · by_cases h7 : (7 : Fin 8) ∈ L
          · exact hL h0 h7 (by decide) (by decide)
          · by_cases h2 : (2 : Fin 8) ∈ L
            · by_cases h3 : (3 : Fin 8) ∈ L
              · exact hL h2 h3 (by decide) (by decide)
              · exact four L hc 4 3 7 6 h4 h3 h7 h6 (by decide) (by decide)
            · exact four L hc 1 2 6 7 h1 h2 h6 h7 (by decide) (by decide)
  · by_cases h3 : (3 : Fin 8) ∈ L
    · by_cases h4 : (4 : Fin 8) ∈ L
      · exact hL h3 h4 (by decide) (by decide)
      · by_cases h7 : (7 : Fin 8) ∈ L
        · exact hL h3 h7 (by decide) (by decide)
        · by_cases h5 : (5 : Fin 8) ∈ L
          · by_cases h6 : (6 : Fin 8) ∈ L
            · exact hL h5 h6 (by decide) (by decide)
            · exact four L hc 4 0 7 6 h4 h0 h7 h6 (by decide) (by decide)
          · exact four L hc 5 4 0 7 h5 h4 h0 h7 (by decide) (by decide)
    · by_cases h5 : (5 : Fin 8) ∈ L
      · by_cases h1 : (1 : Fin 8) ∈ L
        · exact hL h1 h5 (by decide) (by decide)
        · by_cases h4 : (4 : Fin 8) ∈ L
          · exact hL h4 h5 (by decide) (by decide)
          · exact four L hc 1 0 4 3 h1 h0 h4 h3 (by decide) (by decide)
      · by_cases h2 : (2 : Fin 8) ∈ L
        · by_cases h1 : (1 : Fin 8) ∈ L
          · exact hL h1 h2 (by decide) (by decide)
          · by_cases h6 : (6 : Fin 8) ∈ L
            · exact hL h2 h6 (by decide) (by decide)
            · exact four L hc 0 1 5 6 h0 h1 h5 h6 (by decide) (by decide)
        · by_cases h6 : (6 : Fin 8) ∈ L
          · by_cases h7 : (7 : Fin 8) ∈ L
            · exact hL h6 h7 (by decide) (by decide)
            · exact four L hc 0 7 3 2 h0 h7 h3 h2 (by decide) (by decide)
          · exact four L hc 3 2 6 5 h3 h2 h6 h5 (by decide) (by decide)

/-- **Question 5.4 of arXiv:2611.05178 has answer "no"**: the Wagner graph is cubic, has odd
girth 5, and admits no such partition. -/
theorem question54_false : ¬ Question54 := by
  intro h
  obtain ⟨L, hL, hc⟩ := h (Fin 8) wagner (fun v => (wagner_degree v).le) wagner_oddGirth
  exact wagner_no_partition L hL hc

end Hausmann

#print axioms Hausmann.question54_false
