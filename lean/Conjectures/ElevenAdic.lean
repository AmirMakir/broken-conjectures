/-!
# 11-adic congruences on X₀(22): Conjecture 6.1(1) of arXiv:2611.09681 is false

K. Banerjee and N. A. Smoot, *On a Problem of Gordon and Hughes: The 11-adic Properties of
Meromorphic Modular Functions on X₀(22)*, arXiv:2611.09681, Conjecture 6.1, part (1):

> Let `∑ p⁽¹⁾ₐ(n) qⁿ = (−q;q)∞ᵃ / (q;q)∞`. If `a ≡ 3, 5, 7 (mod 11)`, then
> `p⁽¹⁾ₐ(11^α n + δ) ≡ 0 (mod 11^⌈α/2⌉)` for `α ∈ ℕ`, `n ∈ ℕ₀`, where `24δ ≡ 1 − a (mod 11^α)`.

The series is `∏_{n ≥ 1} (1 + qⁿ)ᵃ / (1 − qⁿ)`. We work in `PowerSeries ℤ`:
* `geom n = ∑ₖ q^{nk}` is the inverse of `1 − qⁿ` (`one_sub_mul_geom`);
* `partialProd a b N = ∏_{1 ≤ n ≤ N} (1 + qⁿ)ᵃ · geom(n)ᵇ`;
* **Reduction.** Every factor with `n > N` is `1 + q^{N+1}·(…)`, so the coefficient of `q^N` is
  the same in every partial product with at least `N` factors (`coeff_stable`, proved below).
  This common value is the coefficient of `q^N` in the infinite product, and we define
  `p1 a N := coeff N (partialProd a 1 N)`.

We prove `p1 36 54 = 62043410886974649205238011198`, which is divisible by `11` but not by `121`.
With `a = 36 ≡ 3`, `α = 3`, `n = 0`, `δ = 54` (`24 · 54 = 1296 ≡ 1 − 36 (mod 1331)`) the
conjecture asks for divisibility by `11² = 121`, so it is false.

We state the conjecture for `a ≥ 0` only (`ConjecturePart1`); the paper allows every `a ∈ ℤ`, so
this is a weaker statement and its refutation refutes the paper's.
-/

namespace ElevenAdic

open PowerSeries

/-- `geom n = ∑ₖ q^{nk}`, the power series of `1 / (1 − qⁿ)`. -/
noncomputable def geom (n : ℕ) : PowerSeries ℤ := mk fun k => if n ∣ k then 1 else 0

theorem geom_eq (n : ℕ) (hn : 0 < n) : geom n = 1 + X ^ n * geom n := by
  ext k
  rw [map_add, coeff_one, coeff_X_pow_mul', geom, coeff_mk, coeff_mk]
  by_cases hk : k = 0
  · subst hk
    simp [hn.ne']
  · by_cases hnk : n ≤ k
    · obtain ⟨t, rfl⟩ := Nat.exists_eq_add_of_le hnk
      have e : n ∣ n + t ↔ n ∣ t := by rw [Nat.add_comm]; exact Nat.dvd_add_self_right
      simp only [hk, hnk, e, ite_false, ite_true, zero_add, Nat.add_sub_cancel_left]
    · have : ¬ n ∣ k := fun h => hnk (Nat.le_of_dvd (Nat.pos_of_ne_zero hk) h)
      simp [hk, hnk, this]

/-- `geom n` is the inverse of `1 − qⁿ`. -/
theorem one_sub_mul_geom (n : ℕ) (hn : 0 < n) : (1 - X ^ n) * geom n = 1 := by
  have h := geom_eq n hn
  calc (1 - X ^ n) * geom n = geom n - X ^ n * geom n := by ring
    _ = 1 := by nth_rewrite 1 [h]; ring

/-- The `n`-th factor `(1 + qⁿ)ᵃ / (1 − qⁿ)ᵇ`. -/
noncomputable def factor (a b n : ℕ) : PowerSeries ℤ := (1 + X ^ n) ^ a * geom n ^ b

/-- The partial product over `1 ≤ n ≤ N`. -/
noncomputable def partialProd (a b N : ℕ) : PowerSeries ℤ := ∏ n ∈ Finset.Icc 1 N, factor a b n

/-- Series of the form `1 + qⁿ · H`. -/
def OneMod (n : ℕ) (f : PowerSeries ℤ) : Prop := ∃ H, f = 1 + X ^ n * H

theorem OneMod.mul {n : ℕ} {f g : PowerSeries ℤ} (hf : OneMod n f) (hg : OneMod n g) :
    OneMod n (f * g) := by
  obtain ⟨F, rfl⟩ := hf
  obtain ⟨G, rfl⟩ := hg
  exact ⟨F + G + X ^ n * F * G, by ring⟩

theorem OneMod.pow {n : ℕ} {f : PowerSeries ℤ} (hf : OneMod n f) (a : ℕ) : OneMod n (f ^ a) := by
  induction a with
  | zero => exact ⟨0, by simp⟩
  | succ a ih => rw [pow_succ]; exact ih.mul hf

theorem factor_oneMod (a b n : ℕ) (hn : 0 < n) : OneMod n (factor a b n) :=
  (OneMod.pow ⟨1, by ring⟩ a).mul (OneMod.pow ⟨geom n, geom_eq n hn⟩ b)

/-- Multiplying by a factor with `n > N` does not change the coefficient of `q^N`. -/
theorem coeff_mul_factor (a b n N : ℕ) (hN : N < n) (P : PowerSeries ℤ) :
    coeff N (P * factor a b n) = coeff N P := by
  obtain ⟨H, hH⟩ := factor_oneMod a b n (by omega)
  rw [hH, mul_add, mul_one, map_add, show P * (X ^ n * H) = P * H * X ^ n by ring,
    coeff_mul_X_pow']
  split_ifs with h
  · omega
  · simp

/-- **Reduction**: the coefficient of `q^N` depends only on the factors with `n ≤ N`. -/
theorem coeff_stable (a b N M : ℕ) (h : N ≤ M) :
    coeff N (partialProd a b M) = coeff N (partialProd a b N) := by
  induction M, h using Nat.le_induction with
  | base => rfl
  | succ M hNM ih =>
    rw [partialProd, Finset.prod_Icc_succ_top (by omega), ← partialProd,
      coeff_mul_factor a b (M + 1) N (by omega), ih]

/-- `p⁽¹⁾ₐ(N)`: the coefficient of `q^N` in `(−q;q)∞ᵃ / (q;q)∞` (see `coeff_stable`). -/
noncomputable def p1 (a N : ℕ) : ℤ := coeff N (partialProd a 1 N)

/-- **Conjecture 6.1 (1) of arXiv:2611.09681**, for `a ≥ 0`. -/
def ConjecturePart1 : Prop :=
  ∀ a : ℕ, (a % 11 = 3 ∨ a % 11 = 5 ∨ a % 11 = 7) → ∀ α : ℕ, 1 ≤ α → ∀ n δ : ℕ,
    (24 * δ : ℤ) ≡ 1 - a [ZMOD 11 ^ α] → (11 : ℤ) ^ ((α + 1) / 2) ∣ p1 a (11 ^ α * n + δ)

/-! ### Exact computation with coefficient lists -/

/-- Truncated coefficient list of length `N + 1` built from a function. -/
def tab (N : ℕ) (F : ℕ → ℤ) : List ℤ := (List.range (N + 1)).map F

theorem tab_getD (N : ℕ) (F : ℕ → ℤ) (k : ℕ) (hk : k ≤ N) : (tab N F).getD k 0 = F k := by
  simp [tab, List.getD_eq_getElem?_getD, List.getElem?_range (by omega : k < N + 1)]

/-- Multiply by `1 + qⁿ`, truncated at degree `N`. -/
def mulOnePlus (N n : ℕ) (l : List ℤ) : List ℤ :=
  tab N fun k => l.getD k 0 + if n ≤ k then l.getD (k - n) 0 else 0

/-- Multiply by `geom n`, truncated at degree `N`: the `k`-th coefficient is
`∑_{i ≤ k/n} l_{k - n i}`. -/
def mulGeom (N n : ℕ) (l : List ℤ) : List ℤ :=
  tab N fun k => ∑ i ∈ Finset.range (k / n + 1), l.getD (k - n * i) 0

/-- One factor `(1 + qⁿ)ᵃ · geom n`. -/
def step (N a n : ℕ) (l : List ℤ) : List ℤ := mulGeom N n ((mulOnePlus N n)^[a] l)

/-- The truncated partial product `∏_{1 ≤ n ≤ M}`. -/
def prodList (N a : ℕ) : ℕ → List ℤ
  | 0 => tab N fun k => if k = 0 then 1 else 0
  | M + 1 => step N a (M + 1) (prodList N a M)

/-- `l` lists the coefficients of `f` up to degree `N`. -/
def Approx (N : ℕ) (f : PowerSeries ℤ) (l : List ℤ) : Prop := ∀ k ≤ N, coeff k f = l.getD k 0

theorem approx_mulOnePlus {N n : ℕ} {f : PowerSeries ℤ} {l : List ℤ} (h : Approx N f l) :
    Approx N (f * (1 + X ^ n)) (mulOnePlus N n l) := by
  intro k hk
  rw [mulOnePlus, tab_getD N _ k hk, mul_add, mul_one, map_add, coeff_mul_X_pow', h k hk]
  split_ifs with hnk
  · rw [h (k - n) (by omega)]
  · rfl

theorem approx_iterate {N n : ℕ} {f : PowerSeries ℤ} {l : List ℤ} (h : Approx N f l) (a : ℕ) :
    Approx N (f * (1 + X ^ n) ^ a) ((mulOnePlus N n)^[a] l) := by
  induction a with
  | zero => simpa using h
  | succ a ih =>
    rw [Function.iterate_succ_apply', pow_succ, ← mul_assoc]
    exact approx_mulOnePlus ih

/-- Coefficients of `f · geom n`. -/
theorem coeff_mul_geom (n : ℕ) (hn : 0 < n) (f : PowerSeries ℤ) (k : ℕ) :
    coeff k (f * geom n) = ∑ i ∈ Finset.range (k / n + 1), coeff (k - n * i) f := by
  induction k using Nat.strong_induction_on with
  | _ k ih =>
    have e : f * geom n = f + f * geom n * X ^ n := by
      nth_rewrite 1 [geom_eq n hn]; ring
    rw [e, map_add, coeff_mul_X_pow']
    split_ifs with hnk
    · obtain ⟨t, rfl⟩ := Nat.exists_eq_add_of_le hnk
      rw [Nat.add_sub_cancel_left, ih t (by omega),
        show (n + t) / n = t / n + 1 by rw [Nat.add_comm, Nat.add_div_right t hn],
        Finset.sum_range_succ' _ (t / n + 1)]
      have hs : ∑ i ∈ Finset.range (t / n + 1), coeff (n + t - n * (i + 1)) f =
          ∑ i ∈ Finset.range (t / n + 1), coeff (t - n * i) f :=
        Finset.sum_congr rfl fun i _ => by
          rw [show n + t - n * (i + 1) = t - n * i by rw [Nat.mul_add, Nat.mul_one]; omega]
      rw [hs, Nat.mul_zero, Nat.sub_zero]
      ring
    · have : k / n = 0 := Nat.div_eq_of_lt (by omega)
      simp [this]

theorem approx_mulGeom {N n : ℕ} (hn : 0 < n) {f : PowerSeries ℤ} {l : List ℤ}
    (h : Approx N f l) : Approx N (f * geom n) (mulGeom N n l) := by
  intro k hk
  rw [mulGeom, tab_getD N _ k hk, coeff_mul_geom n hn]
  exact Finset.sum_congr rfl fun i _ => h _ (by omega)

/-- One more factor: from the coefficients of `∏_{n ≤ M}` to those of `∏_{n ≤ M + 1}`. -/
theorem approx_step {N a M M' : ℕ} (hM : M + 1 = M') {l : List ℤ}
    (h : Approx N (partialProd a 1 M) l) : Approx N (partialProd a 1 M') (step N a M' l) := by
  subst hM
  rw [partialProd, Finset.prod_Icc_succ_top (by omega), ← partialProd, step, factor, pow_one,
    ← mul_assoc]
  exact approx_mulGeom (by omega) (approx_iterate h a)

theorem approx_prodList (N a M : ℕ) : Approx N (partialProd a 1 M) (prodList N a M) := by
  induction M with
  | zero =>
    intro k hk
    rw [partialProd, Finset.Icc_eq_empty (by omega), Finset.prod_empty, prodList, tab_getD N _ k hk,
      coeff_one]
  | succ M ih => exact approx_step rfl ih

